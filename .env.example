# Copy to .env when deploying — never commit real keys.
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# WEBHOOK_SECRET=
# GEMINI_MODEL=gemini-3.5-flash
# PORT=3000
# Broadcast (Vercel KV is auto-linked from the Vercel dashboard — Storage → KV):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (If KV comes from the Vercel Marketplace Upstash Redis integration instead,
#  the code also accepts UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.)
# ADMIN_CHAT_ID=  (your Telegram user id — send /myid to the bot to get it)
